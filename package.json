{
  "name": "gielinor-nexus",
  "version": "1.0.0",
  "description": "RS3 Companion - Safe, local desktop companion for RuneScape 3",
  "main": "out/main/main.js",
  "author": "GielinorNexus",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "verify-build": "node scripts/verify-build.js",
    "dist": "electron-vite build && node scripts/verify-build.js && electron-builder --win nsis portable --x64",
    "build:win": "electron-vite build && node scripts/verify-build.js && electron-builder --win",
    "build:win:portable": "electron-vite build && node scripts/verify-build.js && electron-builder --win portable",
    "build:win:installer": "electron-vite build && node scripts/verify-build.js && electron-builder --win nsis",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
